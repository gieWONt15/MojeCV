@model MojeCV.ViewModels.CvViewModel
@{
    ViewData["Title"] = "Moje CV";
}

<header class="mb-4">
    <h1>@Model.Osoba.Imie @Model.Osoba.Nazwisko</h1>
    <p class="lead">@Model.Osoba.Stanowisko</p>
    <p class="text-muted">@Model.Osoba.Email · @Model.Osoba.Telefon · @Model.Osoba.Miasto</p>
    <p>@Model.Osoba.OMnie</p>
</header>

<section class="mb-4">
    <h2>Doświadczenie</h2>
    @foreach (var d in Model.Doswiadczenia.OrderByDescending(d => d.DataOd))
    {
        <div class="mb-3">
            <h5>@d.Stanowisko — @d.Firma</h5>
            <small class="text-muted">
                @d.DataOd.ToString("MM.yyyy") – @(d.DataDo?.ToString("MM.yyyy") ?? "obecnie")
            </small>
            <p>@d.Opis</p>
        </div>
    }
</section>
<section>
    <h2>Umiejętności</h2>
    <ul>
        @foreach (var u in Model.Umiejetnosci)
        {
            <li>@u.Nazwa — @u.Poziom/5</li>
        }
    </ul>
</section>